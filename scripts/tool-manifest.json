    {
      "description": "    训练数据查询端点 - 将 SSE 流式输出转为非流式 JSON 响应\n    \n    用于内部模型训练数据获取场景，接收 pin、requestId、history 和 query，\n    调用底层 Agent 服务，并将 SSE 流式响应聚合为非流式 JSON 输出。\n    \n    实现方式：\n        使用 TrainingQueryService 进行业务编排，\n        TrainingQueryCaller 负责 SSE 流式转非流式聚合。\n    \n    入参格式:\n        - pin: 用户 PIN\n        - requestId: 请求 ID\n        - history: 历史对话列表\n        - query: 当前用户问题\n        - additionParams: 额外的业务参数,如urlParams等\n        \n    出参格式:\n        - code: 状态码，\"00000000\" 表示成功\n        - data: 响应数据\n        - success: 是否成功\n        - message: 结果消息",
      "inputSchema": {
        "properties": {
          "root": {
            "type": "object",
            "properties": {
              "additionParams": {
                "description": "额外业务参数",
                "additionalProperties": true,
                "type": "object"
              },
              "agentId": {
                "description": "应答agent唯一标识",
                "type": "string"
              },
              "pin": {
                "description": "用户PIN",
                "type": "string"
              },
              "requestId": {
                "description": "对话请求ID",
                "type": "string"
              },
              "query": {
                "description": "用户提问内容",
                "type": "string"
              },
              "history": {
                "description": "对话历史记录",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "description": "对话历史角色；user: 用户, assistant: agent助手",
                      "type": "string"
                    },
                    "content": {
                      "description": "对话内容",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "required": [
              "pin",
              "requestId",
              "history",
              "agentId",
              "query"
            ]
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "requestMethod_5731"
    },
